{
  "permissions": {
    "allow": [
      "Bash(make check)", "Bash(make check-fast)",
      "Bash(make lint-php)", "Bash(make lint-front)", "Bash(make analyse)",
      "Bash(make test)", "Bash(make test-front)", "Bash(make build-front)",
      "Bash(make docs-build)", "Bash(make docs-dev)",
      "Bash(docker compose ps*)", "Bash(docker compose logs*)"
    ],
    "ask": ["Bash(git commit *)", "Bash(git push *)"],
    "deny": [
      "Read(./.env)", "Read(./.env.*)",
      "Read(./backups/**)", "Read(./mysql_data/**)",
      "Bash(sudo rm *)", "Bash(docker compose down -v*)", "Bash(make down-volumes*)"
    ]
  },
  "hooks": {
    "PreToolUse": [{
      "matcher": "Write|Edit|NotebookEdit",
      "hooks": [{
        "type": "command",
        "command": "bash \"$CLAUDE_PROJECT_DIR/.agents/hooks/protect-files.sh\"",
        "timeout": 10
      }]
    }],
    "PostToolUse": [{
      "matcher": "Write|Edit",
      "hooks": [{
        "type": "command",
        "command": "bash \"$CLAUDE_PROJECT_DIR/.agents/hooks/lint-file.sh\"",
        "timeout": 60
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "bash \"$CLAUDE_PROJECT_DIR/.agents/hooks/stop-check.sh\"",
        "timeout": 10
      }]
    }]
  }
}
