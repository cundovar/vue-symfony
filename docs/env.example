# Modèle de configuration locale : copier ce fichier en `.env` à la racine, puis adapter les valeurs.
#   cp docs/env.example .env
# Ne jamais versionner le `.env` réel ni y mettre des secrets de production.
# (Le modèle n'est pas à la racine : les règles de permission du projet empêchent les agents de lire `./.env.*`.)

APP_ENV=dev
# Valeur propre à chaque environnement, par exemple : php -r 'echo bin2hex(random_bytes(16));'
APP_SECRET=a-remplacer

# Base MySQL du service `db` de compose.yaml (développement local uniquement)
DATABASE_URL="mysql://root:root@db:3306/mediation_numerique?serverVersion=8.0&charset=utf8mb4"
# Variante sans Docker, pour un essai rapide avec PHP et SQLite :
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
# Production : Brevo par son API (HTTPS, port 443), avec une clé API créée pour ce site
# (Brevo > SMTP & API > Clés API). Ne jamais commiter la clé.
# MAILER_DSN=brevo+api://CLE_API_BREVO@default
# Si l'API n'est pas possible : relais SMTP, identifiant de connexion Brevo encodé (@ -> %40) et clé SMTP
# MAILER_DSN=smtp://identifiant%40exemple.fr:CLE_SMTP_BREVO@smtp-relay.brevo.com:587
# Expéditeur des e-mails (mot de passe oublié) : une adresse d'un domaine authentifié dans Brevo (SPF, DKIM)
MAILER_FROM=ne-pas-repondre@exemple.fr
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Adresse publique utilisée par Vite derrière Nginx (port HOST_HTTP_PORT de compose.yaml)
VITE_DEV_ORIGIN=http://localhost:8094

# Adresse publique du site, en https et sans / final, pour les liens envoyés par e-mail (obligatoire en production)
# MCP_PUBLIC_URL=https://exemple.fr
# Nom du site (défaut : Inclusion numérique) ; la configuration en base est partagée avec mediateur
# SITE_NAME=Inclusion numérique
