{% extends '@EasyAdmin/layout.html.twig' %}

{% block title %}Prévisualisation des modifications{% endblock %}

{% block content_title %}
    <h1><i class="fa fa-eye"></i> Prévisualisation des modifications</h1>
{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-header">
            <h3>Aperçu des changements à appliquer</h3>
        </div>
        <div class="card-body">
            {% if app.session.get('modification_preview') %}
                <div class="preview-content">
                    <pre class="bg-light p-3 border rounded">{{ app.session.get('modification_preview') }}</pre>
                </div>
                
                <div class="mt-4">
                    <a href="{{ path('admin', {page: 1, entityId: app.request.query.get('entityId'), crudAction: 'detail', crudControllerFqcn: 'App\\Controller\\Admin\\ContentRecommendationCrudController'}) }}" 
                       class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Retour aux détails
                    </a>
                </div>
            {% else %}
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle"></i> 
                    Aucune prévisualisation disponible.
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}