<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ title }} — {{ siteName }}</title>
    <style>
        @font-face { font-family: 'Atkinson Hyperlegible'; font-weight: normal; font-style: normal; src: url('{{ fontDir }}/AtkinsonHyperlegible-Regular.ttf') format('truetype'); }
        @font-face { font-family: 'Atkinson Hyperlegible'; font-weight: bold; font-style: normal; src: url('{{ fontDir }}/AtkinsonHyperlegible-Bold.ttf') format('truetype'); }
        @font-face { font-family: 'Atkinson Hyperlegible'; font-weight: normal; font-style: italic; src: url('{{ fontDir }}/AtkinsonHyperlegible-Italic.ttf') format('truetype'); }
        @font-face { font-family: 'Atkinson Hyperlegible'; font-weight: bold; font-style: italic; src: url('{{ fontDir }}/AtkinsonHyperlegible-BoldItalic.ttf') format('truetype'); }

        @page { margin: 1.8cm 1.8cm 2.2cm; }

        body {
            font-family: 'Atkinson Hyperlegible', sans-serif;
            font-size: 13pt;
            line-height: 1.5;
            color: #111;
        }

        /* Pied de page répété : adresse du site, date, mention ; le numéro de page est ajouté par le moteur */
        .pied {
            position: fixed;
            bottom: -1.5cm;
            left: 0;
            right: 0;
            font-size: 8.5pt;
            color: #333;
            border-top: 1px solid #999;
            padding-top: 4px;
        }

        .entete { border-bottom: 2px solid #1e3a8a; padding-bottom: 8px; margin-bottom: 18px; }
        .site { font-size: 10pt; color: #1e3a8a; font-weight: bold; }
        .entete h1 { font-size: 22pt; margin: 6px 0 4px; line-height: 1.2; }
        .contexte { font-size: 10.5pt; color: #333; margin: 0; }

        .cours + .cours { page-break-before: always; }
        .cours h2.titre-cours { font-size: 18pt; margin: 0 0 4px; line-height: 1.25; }
        .niveau {
            display: inline-block;
            font-size: 10.5pt;
            font-weight: bold;
            border: 1px solid #333;
            border-radius: 10px;
            padding: 1px 10px;
            margin: 4px 0 6px;
        }
        .adresse { font-size: 9.5pt; color: #333; margin: 0 0 12px; word-wrap: break-word; }

        .contenu h2 { font-size: 15pt; margin: 18px 0 6px; line-height: 1.3; page-break-after: avoid; }
        .contenu h3 { font-size: 13.5pt; margin: 14px 0 4px; page-break-after: avoid; }
        .contenu p { margin: 0 0 8px; }
        .contenu ul, .contenu ol { margin: 0 0 8px; padding-left: 22px; }
        .contenu li { margin-bottom: 3px; }
        .contenu a { color: #1e3a8a; }

        /* Parties des gabarits, reconnues à leur titre : un repère écrit, pas seulement une couleur */
        .cours-titre--etape { border-left: 5px solid #1e3a8a; padding-left: 8px; }
        .cours-titre--attention { background: #fef3c7; border: 1px solid #b45309; padding: 4px 8px; }
        .cours-titre--exercice { background: #dcfce7; border: 1px solid #15803d; padding: 4px 8px; }
        .cours-titre--aide { background: #e0f2fe; border: 1px solid #0369a1; padding: 4px 8px; }
        .cours-titre--repere { border-bottom: 1px solid #999; }

        .capture-figure { margin: 10px 0 14px; page-break-inside: avoid; text-align: center; }
        .capture-figure img { border: 1px solid #999; }
        .capture-figure figcaption { text-align: left; margin-top: 4px; }
        .capture-caption { font-weight: bold; font-size: 11pt; margin: 0 0 2px; }
        .capture-source { font-size: 9pt; color: #333; margin: 0; word-wrap: break-word; }
    </style>
</head>
<body>
    <div class="pied">
        {{ siteName }} · Version du {{ generatedAt|date('d/m/Y') }} · Ce document n'est pas un document officiel.
    </div>

    <div class="entete">
        <div class="site">{{ siteName }}</div>
        <h1>{{ isModule ? 'Fiche d’atelier : ' ~ title : title }}</h1>
        {% if context %}<p class="contexte">{{ context }}</p>{% endif %}
    </div>

    {% for course in courses %}
        <div class="cours">
            {% if isModule %}<h2 class="titre-cours">{{ course.title }}</h2>{% endif %}
            {% if course.niveau %}<div class="niveau">{{ course.niveau }}</div>{% endif %}
            <p class="adresse">Ce cours en ligne : {{ course.url }}</p>
            <div class="contenu">{{ course.html|raw }}</div>
        </div>
    {% endfor %}
</body>
</html>
